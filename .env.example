# Base de datos PostgreSQL
# Para Coolify: usa el nombre del servicio PostgreSQL de Coolify
DB_HOST=${POSTGRES_HOST:-localhost}
DB_PORT=${POSTGRES_PORT:-5434}
DB_NAME=${POSTGRES_DB:-adso_fincas}
DB_USER=${POSTGRES_USER:-postgres}
DB_PASSWORD=${POSTGRES_PASSWORD:-tu_contrasena_aquí}

# Seguridad JWT
# Genera un secret seguro con: openssl rand -base64 32
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=${JWT_EXPIRATION:-86400000}

# Perfil de Spring (dev/prod)
SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE:-prod}
